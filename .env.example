# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tax_db
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/tax_db

# Neo4j
NEO4J_PASSWORD=change-me-to-a-strong-password

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MIN=1440

# 생성 LLM: OpenRouter GPT-6 Luna 유료 모델 (API 키는 실제 .env에만 입력)
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_REMOTE_MAX_TOKENS=8192
LLM_TIMEOUT_SEC=180
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Ollama 임베딩
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=openai/gpt-6-luna
# Optional per-task override: each task inherits LLM_PROVIDER / CHAT_MODEL unless set.
# LLM_TASK_TOOL_SELECTION_PROVIDER=ollama
# LLM_TASK_TOOL_SELECTION_MODEL=qwen3.5:9b
# LLM_TASK_TOOL_SELECTION_REASONING_EFFORT=low
# LLM_TASK_QUERY_CLASSIFICATION_REASONING_EFFORT=low
# LLM_TASK_ANSWER_REASONING_EFFORT=low
# LLM_TASK_HISTORY_ANSWER_REASONING_EFFORT=low
# LLM_TASK_CITATION_EXTRACTION_REASONING_EFFORT=low
# LLM_TASK_DOCUMENT_CLASSIFICATION_REASONING_EFFORT=none
# Optional offline Knowledge Graph relation Judge settings (defaults to chat provider/model).
# KG_JUDGE_PROVIDER=openrouter
# KG_JUDGE_MODEL=openai/gpt-6-luna
# KG_JUDGE_REASONING_EFFORT=low
# KG_JUDGE_BASE_URL=https://openrouter.ai/api/v1
# KG_JUDGE_API_KEY=                 # Optional; otherwise use the selected provider's key.
# KG_JUDGE_TIMEOUT_SEC=120
# KG_JUDGE_MAX_TOKENS=512
# KG_JUDGE_INPUT_BUDGET_BYTES=6000
# KG_JUDGE_NUM_CTX=8192
EMBED_MODEL=qwen3-embedding:4b

# External APIs
LAW_API_KEY=
TAVILY_API_KEY=

# LangSmith 채팅 추적과 별도 평가 전송용
# 채팅 추적 시 질문·근거·답변이 LangSmith로 전송됨. 실제 키와 사용 가능 quota 필요.
CHAT_TRACING_ENABLED=true
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY

# ── 아래는 선택 설정입니다. 주석의 값이 코드 기본값이므로 바꿀 때만 주석을 푸세요. ──

# LLM 호출
# LLM_API_KEY=local-llamacpp           # 로컬 llama.cpp 등 OpenAI 호환 서버용
# OPENROUTER_REQUESTS_PER_MINUTE=18        # 무료 :free 모델에만 적용
# OPENROUTER_PAID_REQUESTS_PER_MINUTE=0    # 유료 모델 간격(0 = 없음)
# LLM_DEVICE=auto
# THINK_ENABLED=false
# OLLAMA_NUM_CTX=4096
# OLLAMA_KEEP_ALIVE_SEC=-1

# 답변 검사 (claim_verification)
# ANSWER_JUDGE_MODE=shadow             # shadow: Judge 결과를 기록만, enforce: 의미 검사 실패 주장을 보류
# CLAIM_SIGNAL_GATE=judge              # judge: 단어 추정 신호는 Judge가 확인 (block으로 되돌리지 말 것)

# 임베딩
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:4b
# EMBEDDING_DEVICE=auto
# EMBEDDING_TIMEOUT_SEC=300
# EMBEDDING_VERSION=v1                 # v2는 별도 llama.cpp 임베딩 서버(docker-compose.llamacpp.yml)
# EMBEDDING_DUAL_WRITE=false
# EMBEDDING_V1_PROVIDER=ollama
# EMBEDDING_V1_BASE_URL=http://localhost:11434
# EMBEDDING_V1_MODEL=qwen3-embedding:4b
# EMBEDDING_V2_PROVIDER=llamacpp
# EMBEDDING_V2_BASE_URL=http://llama_embedding:8080/v1
# EMBEDDING_V2_MODEL=qwen3-embedding:4b-gguf

# GraphRAG (Neo4j)
# GRAPH_RAG_ENABLED=false
# HISTORY_GRAPH_RAG_ENABLED=false
# GRAPH_TIMEOUT_SEC=3
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# 검색
# SIMILARITY_THRESHOLD=0.4
# SEARCH_LEXICAL_BACKEND=bm25
# SEARCH_BM25_REFRESH_SEC=60
# SEARCH_BM25_TITLE_WEIGHT=2
# SEARCH_RRF_K=10
# SEARCH_LEXICAL_WEIGHT=0.5
# SEARCH_EMBED_CACHE_TTL_SEC=600
# SEARCH_EMBED_CACHE_SIZE=512
# SEARCH_FUZZY_ENABLED=true
# SEARCH_REGEX_ENABLED=true
# SEARCH_MMR_ENABLED=true
# SEARCH_MMR_LAMBDA=0.85
# SEARCH_QUERY_INSTRUCTION_ENABLED=false

# 업로드·쿠키
# MAX_UPLOAD_MB=50
# COOKIE_SECURE=false                  # HTTPS로 서비스하면 true

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tax_db
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/tax_db

# Authentication
JWT_SECRET=replace-with-a-long-random-value

# Generation LLM
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://llama_chat:8080/v1
LLM_API_KEY=local-llamacpp
LLM_DEVICE=gpu
CHAT_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=4096
LLAMACPP_CHAT_REPO=unsloth/Qwen3.5-9B-GGUF:Q4_K_M
LLAMACPP_CHAT_CTX_SIZE=2048
LLAMACPP_CHAT_PARALLEL=1
LLAMACPP_CHAT_GPU_LAYERS=99

# Active embedding remains v1 until compatibility, backfill, and eval pass.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://ollama.windows.host:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DEVICE=cpu
EMBEDDING_VERSION=v1
EMBEDDING_DUAL_WRITE=false

# Side-by-side migration providers
EMBEDDING_V1_PROVIDER=ollama
EMBEDDING_V1_BASE_URL=http://ollama.windows.host:11434
EMBEDDING_V1_MODEL=qwen3-embedding:4b
EMBEDDING_V2_PROVIDER=llamacpp
EMBEDDING_V2_BASE_URL=http://llama_embedding:8080/v1
EMBEDDING_V2_MODEL=qwen3-embedding:4b-gguf
LLAMACPP_EMBEDDING_REPO=Qwen/Qwen3-Embedding-4B-GGUF:Q4_K_M
LLAMACPP_EMBEDDING_MODEL=qwen3-embedding:4b-gguf
LLAMACPP_EMBEDDING_CTX_SIZE=8192
